page {
  background:
    radial-gradient(circle at 50% -10%, rgba(255, 194, 94, 0.12), transparent 42%),
    radial-gradient(circle at 10% 15%, rgba(145, 76, 255, 0.1), transparent 44%),
    radial-gradient(circle at 88% 22%, rgba(42, 91, 211, 0.12), transparent 48%),
    linear-gradient(180deg, #050609 0%, #0a0d16 48%, #080a10 100%);
  color: #f6edd8;
  font-family: 'PingFang SC', 'Hiragino Sans GB', 'Noto Sans CJK SC', sans-serif;
}

.view-port {
  min-height: 100vh;
  padding: 22rpx 18rpx 28rpx;
  box-sizing: border-box;
}

.phone-screen {
  border-radius: 30rpx;
  border: 1px solid rgba(247, 206, 130, 0.2);
  background:
    radial-gradient(circle at 18% 8%, rgba(255, 201, 115, 0.08), transparent 38%),
    linear-gradient(180deg, rgba(22, 17, 12, 0.72), rgba(14, 17, 28, 0.96)),
    repeating-linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.01) 0rpx,
      rgba(255, 255, 255, 0.01) 2rpx,
      transparent 2rpx,
      transparent 10rpx
    );
  box-shadow:
    0 24rpx 60rpx rgba(0, 0, 0, 0.46),
    inset 0 1rpx 0 rgba(255, 230, 190, 0.08),
    inset 0 -1rpx 0 rgba(96, 120, 170, 0.1);
  padding: 20rpx;
}

.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  border: 1px solid rgba(255, 214, 133, 0.35);
  background: linear-gradient(180deg, rgba(78, 48, 21, 0.36), rgba(34, 25, 16, 0.26));
  color: #ffdfa5;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.tag::before {
  content: '•';
  color: #ffd174;
  font-size: 24rpx;
  line-height: 1;
}

.phase-badge {
  border-radius: 999rpx;
  border: 1px solid rgba(137, 154, 198, 0.28);
  background: rgba(44, 54, 82, 0.35);
  color: #c8d5f3;
  font-size: 20rpx;
  padding: 8rpx 14rpx;
}

.title {
  margin: 16rpx 0 10rpx;
  color: #fff6e5;
  font-size: 52rpx;
  line-height: 1.14;
  font-weight: 700;
  text-shadow: 0 8rpx 18rpx rgba(255, 177, 67, 0.08);
}

.subtitle {
  margin: 0 0 14rpx;
  color: #b4bfd9;
  font-size: 25rpx;
  line-height: 1.48;
}

.hero-strip {
  margin-bottom: 14rpx;
  border-radius: 16rpx;
  border: 1px solid rgba(118, 134, 170, 0.22);
  background:
    linear-gradient(180deg, rgba(34, 39, 58, 0.85), rgba(16, 18, 28, 0.9));
  padding: 14rpx 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14rpx;
}

.hero-meta {
  color: #c7d2ee;
  font-size: 22rpx;
  line-height: 1.35;
}

.hero-strong {
  color: #ffe2af;
  font-weight: 700;
  font-size: 28rpx;
}

.panel {
  border-radius: 18rpx;
  border: 1px solid rgba(124, 141, 181, 0.22);
  background:
    linear-gradient(180deg, rgba(21, 24, 36, 0.92), rgba(12, 13, 19, 0.94));
  padding: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.panel-highlight {
  border-color: rgba(241, 196, 121, 0.3);
  background:
    radial-gradient(circle at 0 0, rgba(255, 180, 73, 0.07), transparent 44%),
    linear-gradient(180deg, rgba(32, 25, 19, 0.95), rgba(16, 17, 25, 0.96));
}

.parchment-panel {
  border-radius: 16rpx;
  border: 1px solid rgba(201, 164, 101, 0.3);
  background:
    linear-gradient(180deg, rgba(71, 53, 31, 0.18), rgba(45, 35, 23, 0.14)),
    linear-gradient(180deg, rgba(30, 26, 21, 0.9), rgba(20, 19, 19, 0.9));
  padding: 14rpx;
}

.section-title {
  margin: 2rpx 0 0;
  color: #e7c991;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.section-subtitle {
  margin-top: -4rpx;
  color: #99a7c7;
  font-size: 21rpx;
}

.label {
  color: #9baad0;
  font-size: 22rpx;
}

.input {
  border-radius: 14rpx;
  border: 1px solid rgba(117, 136, 181, 0.34);
  background:
    linear-gradient(180deg, rgba(24, 29, 45, 0.95), rgba(17, 21, 34, 0.96));
  color: #eff5ff;
  padding: 18rpx;
  font-size: 28rpx;
}

.input::placeholder {
  color: #6f7ea3;
}

.btn {
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
  padding: 18rpx;
  line-height: 1.1;
}

.btn::after {
  border: none;
}

.btn-primary {
  background:
    radial-gradient(circle at 15% 10%, rgba(255, 255, 255, 0.4), transparent 36%),
    linear-gradient(180deg, #b8453f 0%, #8f2726 56%, #6d161a 100%);
  color: #ffe7c6;
  border: 1px solid rgba(255, 209, 176, 0.22);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 238, 220, 0.26),
    0 8rpx 18rpx rgba(109, 22, 26, 0.28);
}

.btn-ghost {
  background:
    linear-gradient(180deg, rgba(31, 37, 57, 0.92), rgba(20, 25, 39, 0.92));
  color: #dde6ff;
  border: 1px solid rgba(114, 133, 176, 0.34);
}

.btn[disabled] {
  opacity: 0.46;
}

.timer {
  border-radius: 12rpx;
  border: 1px solid rgba(114, 132, 173, 0.28);
  background: rgba(25, 30, 47, 0.84);
  color: #d9e6ff;
  padding: 12rpx 14rpx;
  font-weight: 700;
  font-size: 24rpx;
}

.timer-danger {
  border-color: rgba(244, 137, 108, 0.38);
  background: rgba(78, 26, 18, 0.35);
  color: #ffd3cb;
}

.row-list {
  color: #d2ddfb;
  font-size: 24rpx;
  line-height: 1.55;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  border-radius: 999rpx;
  border: 1px solid rgba(146, 125, 93, 0.32);
  background:
    linear-gradient(180deg, rgba(67, 50, 30, 0.2), rgba(28, 27, 34, 0.52));
  color: #ecd7b4;
  font-size: 22rpx;
  padding: 10rpx 15rpx;
}

.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.choice,
.vote {
  border-radius: 14rpx;
  border: 1px solid rgba(139, 123, 93, 0.28);
  background:
    radial-gradient(circle at 0 0, rgba(255, 188, 83, 0.06), transparent 44%),
    linear-gradient(180deg, rgba(43, 33, 25, 0.92), rgba(25, 23, 27, 0.92));
  color: #f0e6d0;
  font-size: 25rpx;
  line-height: 1.36;
  padding: 18rpx 16rpx;
  text-align: left;
}

.vote {
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
}

.choice-active,
.vote-active {
  border-color: rgba(255, 215, 142, 0.54);
  background:
    radial-gradient(circle at 0 0, rgba(255, 190, 82, 0.14), transparent 44%),
    linear-gradient(180deg, rgba(88, 55, 32, 0.9), rgba(41, 28, 22, 0.92));
  color: #fff3da;
  box-shadow:
    inset 0 0 0 2rpx rgba(255, 214, 133, 0.08),
    0 6rpx 16rpx rgba(67, 38, 20, 0.18);
}

.result-item {
  border-radius: 14rpx;
  border: 1px solid rgba(132, 145, 181, 0.2);
  background: rgba(22, 28, 44, 0.68);
  padding: 14rpx 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 10rpx;
}

.muted-inline {
  color: #97a7ce;
  font-size: 20rpx;
  margin-left: 8rpx;
}

.link-row {
  margin-top: 12rpx;
  display: flex;
  gap: 10rpx;
}

.link-btn {
  flex: 1;
  border-radius: 12rpx;
  border: 1px dashed rgba(122, 139, 178, 0.35);
  background: rgba(18, 24, 39, 0.36);
  color: #ccd9f9;
  padding: 14rpx;
  font-size: 22rpx;
}

.empty-hint {
  border-radius: 12rpx;
  border: 1px dashed rgba(110, 126, 161, 0.3);
  background: rgba(17, 20, 30, 0.4);
  color: #98a7c8;
  font-size: 22rpx;
  padding: 14rpx;
}

.pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.pill {
  border-radius: 999rpx;
  padding: 8rpx 12rpx;
  font-size: 20rpx;
  color: #d7e2ff;
  border: 1px solid rgba(114, 132, 172, 0.24);
  background: rgba(30, 36, 57, 0.42);
}
