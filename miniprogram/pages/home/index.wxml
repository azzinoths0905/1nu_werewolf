<view class="view-port">
  <view class="phone-screen">
    <view class="tag">首页</view>
    <view class="title">今晚谁是狼人？</view>
    <view class="subtitle">输入昵称，3-20 人线下开玩。</view>

    <view class="panel debug-panel" wx:if="{{showDebugIdentityTools}}">
      <view class="label">开发调试：玩家标识（同账号多端测试）</view>
      <input
        class="input"
        placeholder="例如：A 或 B"
        maxlength="24"
        value="{{debugPlayerId}}"
        bindinput="onDebugPlayerIdInput"
      />
      <view class="debug-actions">
        <button class="btn btn-ghost debug-btn" data-playerid="A" bindtap="setDebugPlayerPreset">设为 A</button>
        <button class="btn btn-ghost debug-btn" data-playerid="B" bindtap="setDebugPlayerPreset">设为 B</button>
        <button class="btn btn-ghost debug-btn" bindtap="clearDebugPlayerId">清空</button>
      </view>
      <view class="debug-tip">不同设备设置不同标识后，将被视作不同玩家。</view>
    </view>

    <view class="panel">
      <view class="label">昵称</view>
      <input class="input" placeholder="例如：阿哲" maxlength="20" value="{{nickname}}" bindinput="onNicknameInput" />

      <view class="label">房间码（加入房间时必填）</view>
      <input class="input" placeholder="例如：7K9M" maxlength="6" value="{{roomCode}}" bindinput="onRoomCodeInput" />

      <button class="btn btn-primary" bindtap="createRoom">创建房间</button>
      <button class="btn btn-ghost" bindtap="joinRoom">加入房间</button>
    </view>
  </view>
</view>
